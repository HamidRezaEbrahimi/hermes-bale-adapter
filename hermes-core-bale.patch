+    """Bot honouring TELEGRAM_PROXY / BALE_PROXY; falls back to a direct connection."""
     from telegram import Bot
+    from os import environ as _env
+    from gateway.platforms.base import resolve_proxy_url
+    from telegram.request import HTTPXRequest
+
+    bale_token = str(_env.get("BALE_BOT_TOKEN", "")).strip()
+    is_bale = bool(bale_token and token == bale_token)
+    base_url = "https://tapi.bale.ai/bot" if is_bale else None
+    proxy_var = "BALE_PROXY" if is_bale else "TELEGRAM_PROXY"
